; Engine configuration file.
; Godot rewrites this on import. Keep the name and the main scene.

config_version=5

[application]

config/name="Penguin Pass"
config/description="Ride a 5 km mountain loop on a smart trainer."
config/features=PackedStringArray("4.7", "Mobile")
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.53, 0.68, 0.82, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
