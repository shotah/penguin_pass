"AppBuild"
{
	"AppID" "YOUR_APP_ID" // replace with the Steamworks app ID
	"Desc" "Penguin Pass Linux, Windows, and macOS" // visible only in Steamworks build history
	"Preview" "0" // set to "1" for a local manifest only; nothing is uploaded
	"ContentRoot" "../../dist" // relative to this file; each depot maps one folder
	"BuildOutput" "../../dist/steam-build-output" // logs and chunk cache, gitignored
	"Depots"
	{
		"YOUR_LINUX_DEPOT_ID" "depot_build_linux.vdf"
		"YOUR_WINDOWS_DEPOT_ID" "depot_build_windows.vdf"
		"YOUR_MACOS_DEPOT_ID" "depot_build_macos.vdf"
	}
}
