; Stand-alone preview project for the pp-rider model.
; It loads no GDExtension, so the game library cannot break a render.

config_version=5

[application]

config/name="Penguin Pass rider preview"
config/description="Renders the procedural bike and rider to PNG."
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=480
window/size/viewport_height=300
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.53, 0.68, 0.82, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
